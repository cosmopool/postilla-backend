# postilla CLI configuration. Copy to cli.env (never commit it) and fill in the required
# values. The CLI loads cli.env from the current directory when it is there; a variable
# already set in the environment wins over the file. It refuses to run when a required
# value is missing. See "Configuration" in docs/specification.md.

# --- Server -------------------------------------------------------------------

# Required. Base URL of postilla-server, e.g. https://api.example.com. The CLI reads the
# lists (GET /languages, /genres, /tags, /authors) and publishes (POST /stories) there.
POSTILLA_SERVER_URL=
# Required. The server's POSTILLA_AUTHOR_TOKEN, for POST /stories.
POSTILLA_AUTHOR_TOKEN=

# --- Outside services ---------------------------------------------------------

# Required. OpenCode key, used for Jev (moderation) and DeepSeek (translation).
POSTILLA_OPENCODE_KEY=
# Optional. OpenCode's base URL; Jev is at /systemone/v1/systemone and DeepSeek at
# /go/v1/chat/completions under it.
# POSTILLA_OPENCODE_URL=https://opencode.ai/inference
# Required. Speechify key, used for simba-3.5 (narration).
POSTILLA_SPEECHIFY_KEY=
# Optional. Speechify's base URL; narrate streams from /v1/audio/stream/with-timestamps under it.
# POSTILLA_SPEECHIFY_URL=https://api.speechify.ai

# --- R2 -----------------------------------------------------------------------

# Required. Cloudflare account id.
POSTILLA_R2_ACCOUNT_ID=
# Optional. R2's S3 API base URL; unset means https://<account>.r2.cloudflarestorage.com.
# POSTILLA_R2_ENDPOINT=
# Required. R2 S3 API credentials, with write access to the story bucket.
POSTILLA_R2_ACCESS_KEY_ID=
POSTILLA_R2_SECRET_ACCESS_KEY=
# Required. The public bucket: stories, and the dictionary the content build publishes.
POSTILLA_R2_BUCKET=

# --- Stories ------------------------------------------------------------------

# Where the CLI caches the current dict.db build (read from dict/latest in R2).
POSTILLA_DICT_DIR=./dict
# Minimum P(none) from Jev for a story to pass moderation, from 0 to 1.
POSTILLA_MODERATION_THRESHOLD=0.9
