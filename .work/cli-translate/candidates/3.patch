+/// One Jev call (specification.md, `postilla translate`): `text` against the `hate` question,
+/// at `base` (`POSTILLA_OPENCODE_URL`) with `key`. Returns Jev's status and, when it is 200,
+/// the probabilities of `none`, `homophobic`, `racist`, `sexist`, `religious` and
+/// `other_hate`, in that order.
+pub fn moderate(io: Io, a: Allocator, base: []const u8, key: []const u8, text: []const u8) !struct { std.http.Status, [6]f64 } {
+    const body = try std.json.Stringify.valueAlloc(a, .{ .model = "jev-1.13", .state = text, .questions = .{ .hate = .{
+        .type = "choice",
+        .instructions = "Does this Italian text contain hate speech? Pick the kind, or none.",
+        .criteria = .{
+            .none = "No hate speech: the text attacks no group for who they are",
+            .homophobic = "Attacks or demeans people for their sexual orientation or gender identity",
+            .racist = "Attacks or demeans people for their race, ethnicity or nationality",
+            .sexist = "Attacks or demeans people for their sex or gender",
+            .religious = "Attacks or demeans people for their religion",
+            .other_hate = "Attacks or demeans another protected group, such as disabled people",
+        },
+    } } }, .{});
+    const res = try outbound.request(io, a, .{}, .POST, try std.fmt.allocPrint(a, "{s}/systemone/v1/systemone", .{base}), &.{
+        .{ .name = "authorization", .value = try std.fmt.allocPrint(a, "Bearer {s}", .{key}) },
+        .{ .name = "user-agent", .value = "postilla/1.0" },
+        .{ .name = "content-type", .value = "application/json" },
+    }, body, "");
+    if (res.status != .ok) return .{ res.status, undefined };
+    const p = (try std.json.parseFromSliceLeaky(struct { answers: struct { hate: struct { probabilities: struct { none: f64, homophobic: f64, racist: f64, sexist: f64, religious: f64, other_hate: f64 } } } }, a, res.body, .{ .ignore_unknown_fields = true })).answers.hate.probabilities;
+    return .{ .ok, .{ p.none, p.homophobic, p.racist, p.sexist, p.religious, p.other_hate } };
+}
