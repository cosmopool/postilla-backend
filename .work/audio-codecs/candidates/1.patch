+/// The `.c` files in `dirs` of `dep`, without demos, tools, SIMD intrinsics and Ogg.
+fn cFiles(b: *std.Build, dep: *std.Build.Dependency, dirs: []const []const u8) []const []const u8 {
+    const io = b.graph.io;
+    var files: std.ArrayList([]const u8) = .empty;
+    for (dirs) |d| {
+        var dir = dep.builder.root.root_dir.handle.openDir(io, d, .{ .iterate = true }) catch @panic("cannot open a vendored source dir");
+        defer dir.close(io);
+        var it = dir.iterate();
+        next: while (it.next(io) catch @panic("cannot list a vendored source dir")) |e| {
+            if (!std.mem.endsWith(u8, e.name, ".c")) continue;
+            for ([_][]const u8{ "demo", "compare", "mini_kfft", "intrin", "aspect", "ogg_helper", "ogg_mapping", "metadata_iterators" }) |skip| if (std.mem.indexOf(u8, e.name, skip) != null) continue :next;
+            files.append(b.allocator, b.pathJoin(&.{ d, e.name })) catch @panic("OOM");
+        }
+    }
+    return files.items;
+}
