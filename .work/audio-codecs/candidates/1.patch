@@ -0,0 +1,80 @@
+//! The narration's PCM to its two files, in memory: the Ogg Opus `.opus` for the app and
+//! the lossless `.flac` master (docs/specification.md, `postilla narrate`).
+
+const std = @import("std");
+const c = @import("c");
+
+pub const Encoded = struct { opus: []u8, flac: []u8, audio_ms: u32 };
+
+/// Encodes 16-bit mono `samples` at `rate` Hz, the files allocated in `a`. The same samples
+/// and rate give the same bytes.
+pub fn encode(a: std.mem.Allocator, samples: []const i16, rate: u32) !Encoded {
+    if (samples.len == 0) return error.NoAudio;
+    if (rate < 8000 or rate > 96000) return error.UnsupportedRate;
+    // The write callbacks fail only when `a` does: libopusenc answers OPE_WRITE_FAIL then,
+    // libFLAC FLAC__STREAM_ENCODER_CLIENT_ERROR.
+    var opus: std.Io.Writer.Allocating = .init(a);
+    defer opus.deinit();
+    var flac: std.Io.Writer.Allocating = .init(a);
+    defer flac.deinit();
+
+    const comments = c.ope_comments_create() orelse return error.OpusEncode;
+    defer c.ope_comments_destroy(comments);
+    const callbacks: c.OpusEncCallbacks = .{ .write = writeOpus, .close = closeOpus };
+    var err: c_int = 0;
+    const ope = c.ope_encoder_create_callbacks(&callbacks, &opus, comments, @intCast(rate), 1, 0, &err) orelse return error.OpusEncode;
+    defer c.ope_encoder_destroy(ope);
+    // A fixed serial number instead of a random one keeps the output deterministic.
+    for ([_][2]c_int{
+        .{ c.OPE_SET_SERIALNO_REQUEST, 1 },
+        .{ c.OPUS_SET_BITRATE_REQUEST, 16000 },
+        .{ c.OPUS_SET_SIGNAL_REQUEST, c.OPUS_SIGNAL_VOICE },
+        .{ c.OPUS_SET_COMPLEXITY_REQUEST, 10 },
+    }) |ctl| if (c.ope_encoder_ctl(ope, ctl[0], ctl[1]) != c.OPE_OK) return error.OpusEncode;
+    // A failed write is kept and answered again by drain.
+    _ = c.ope_encoder_write(ope, samples.ptr, @intCast(samples.len));
+    switch (c.ope_encoder_drain(ope)) {
+        c.OPE_OK => {},
+        c.OPE_WRITE_FAIL => return error.OutOfMemory,
+        else => return error.OpusEncode,
+    }
+
+    const wide = try a.alloc(i32, samples.len);
+    defer a.free(wide);
+    for (samples, wide) |s, *w| w.* = s;
+    const fe = c.FLAC__stream_encoder_new() orelse return error.FlacEncode;
+    defer c.FLAC__stream_encoder_delete(fe);
+    // 16 bits and the MD5 signature are libFLAC's defaults; setters fail only once initialized.
+    _ = c.FLAC__stream_encoder_set_channels(fe, 1);
+    _ = c.FLAC__stream_encoder_set_sample_rate(fe, rate);
+    _ = c.FLAC__stream_encoder_set_compression_level(fe, 8);
+    _ = c.FLAC__stream_encoder_set_total_samples_estimate(fe, samples.len);
+    if (c.FLAC__stream_encoder_init_stream(fe, writeFlac, null, null, null, &flac) != c.FLAC__STREAM_ENCODER_INIT_STATUS_OK or
+        c.FLAC__stream_encoder_process_interleaved(fe, wide.ptr, @intCast(samples.len)) == 0 or
+        c.FLAC__stream_encoder_finish(fe) == 0)
+        return if (c.FLAC__stream_encoder_get_state(fe) == c.FLAC__STREAM_ENCODER_CLIENT_ERROR) error.OutOfMemory else error.FlacEncode;
+
+    const opus_bytes = try opus.toOwnedSlice();
+    errdefer a.free(opus_bytes);
+    const flac_bytes = try flac.toOwnedSlice();
+    // With no seek callback libFLAC cannot go back to STREAMINFO, so its MD5 (of the
+    // samples as little-endian bytes, the targets' order) is written here.
+    std.crypto.hash.Md5.hash(std.mem.sliceAsBytes(samples), flac_bytes[26..42], .{});
+    return .{ .opus = opus_bytes, .flac = flac_bytes, .audio_ms = @intCast(samples.len * 1000 / rate) };
+}
+
+fn writeOpus(user: ?*anyopaque, bytes: [*c]const u8, len: i32) callconv(.c) c_int {
+    const w: *std.Io.Writer.Allocating = @ptrCast(@alignCast(user));
+    w.writer.writeAll(bytes[0..@intCast(len)]) catch return 1;
+    return 0;
+}
+
+fn closeOpus(_: ?*anyopaque) callconv(.c) c_int {
+    return 0;
+}
+
+fn writeFlac(_: [*c]const c.FLAC__StreamEncoder, bytes: [*c]const u8, len: usize, _: u32, _: u32, client: ?*anyopaque) callconv(.c) c.FLAC__StreamEncoderWriteStatus {
+    const w: *std.Io.Writer.Allocating = @ptrCast(@alignCast(client));
+    w.writer.writeAll(bytes[0..len]) catch return c.FLAC__STREAM_ENCODER_WRITE_STATUS_FATAL_ERROR;
+    return c.FLAC__STREAM_ENCODER_WRITE_STATUS_OK;
+}
