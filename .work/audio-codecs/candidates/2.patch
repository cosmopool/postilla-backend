--- /dev/null
+++ b/src/audio.zig
@@ -0,0 +1,80 @@
+//! 16-bit mono PCM in memory to the narration's two files in memory: the Ogg Opus `.opus`
+//! for the app, through libopusenc over libopus, and the lossless `.flac` master, through
+//! libFLAC. The same samples and rate always give the same bytes.
+
+const std = @import("std");
+const c = @import("c");
+
+pub const Encoded = struct {
+    opus: []u8 = &.{},
+    flac: []u8 = &.{},
+    /// The PCM's length: its sample count ÷ its rate × 1000, rounded down.
+    audio_ms: u32 = 0,
+};
+
+/// Encodes `samples` at `rate` Hz to 16 kbit/s voice Opus (complexity 10, Ogg serial 1) and
+/// to level 8 FLAC. Both files are allocated in `a`.
+pub fn encode(a: std.mem.Allocator, samples: []const i16, rate: u32) !Encoded {
+    if (samples.len == 0) return error.NoAudio;
+    if (rate < 8000 or rate > 96000) return error.UnsupportedRate;
+
+    // libopusenc's pull API keeps the pages until they are copied out after the drain.
+    var opus: std.ArrayList(u8) = .empty;
+    errdefer opus.deinit(a);
+    {
+        const comments = c.ope_comments_create() orelse return error.OpusEncode;
+        defer c.ope_comments_destroy(comments);
+        const enc = c.ope_encoder_create_pull(comments, @intCast(rate), 1, 0, null) orelse return error.OpusEncode;
+        defer c.ope_encoder_destroy(enc);
+        _ = c.ope_encoder_ctl(enc, c.OPE_SET_SERIALNO_REQUEST, @as(c_int, 1));
+        _ = c.ope_encoder_ctl(enc, c.OPUS_SET_BITRATE_REQUEST, @as(c_int, 16000));
+        _ = c.ope_encoder_ctl(enc, c.OPUS_SET_SIGNAL_REQUEST, @as(c_int, c.OPUS_SIGNAL_VOICE));
+        _ = c.ope_encoder_ctl(enc, c.OPUS_SET_COMPLEXITY_REQUEST, @as(c_int, 10));
+        if (c.ope_encoder_write(enc, samples.ptr, @intCast(samples.len)) != c.OPE_OK or c.ope_encoder_drain(enc) != c.OPE_OK)
+            return error.OpusEncode;
+        var page: [*c]u8 = undefined;
+        var len: i32 = 0;
+        while (c.ope_encoder_get_page(enc, &page, &len, 0) == 1) try opus.appendSlice(a, page[0..@intCast(len)]);
+    }
+
+    var flac: std.Io.Writer.Allocating = .init(a);
+    defer flac.deinit();
+    {
+        const enc = c.FLAC__stream_encoder_new() orelse return error.FlacEncode;
+        defer c.FLAC__stream_encoder_delete(enc);
+        _ = c.FLAC__stream_encoder_set_channels(enc, 1);
+        _ = c.FLAC__stream_encoder_set_bits_per_sample(enc, 16);
+        _ = c.FLAC__stream_encoder_set_sample_rate(enc, rate);
+        _ = c.FLAC__stream_encoder_set_compression_level(enc, 8);
+        _ = c.FLAC__stream_encoder_set_total_samples_estimate(enc, samples.len);
+        var ok = c.FLAC__stream_encoder_init_stream(enc, writeFlac, null, null, setMd5, &flac) == c.FLAC__STREAM_ENCODER_INIT_STATUS_OK;
+        var block: [4096]i32 = undefined;
+        var chunks = std.mem.window(i16, samples, block.len, block.len);
+        while (ok) {
+            const chunk = chunks.next() orelse break;
+            for (chunk, block[0..chunk.len]) |s, *d| d.* = s;
+            ok = c.FLAC__stream_encoder_process_interleaved(enc, &block, @intCast(chunk.len)) != 0;
+        }
+        // The write callback fails only when `a` does; libFLAC calls that a client error.
+        if (!ok or c.FLAC__stream_encoder_finish(enc) == 0)
+            return if (c.FLAC__stream_encoder_get_state(enc) == c.FLAC__STREAM_ENCODER_CLIENT_ERROR) error.OutOfMemory else error.FlacEncode;
+    }
+
+    const flac_bytes = try flac.toOwnedSlice();
+    errdefer a.free(flac_bytes);
+    return .{ .opus = try opus.toOwnedSlice(a), .flac = flac_bytes, .audio_ms = @intCast(samples.len * 1000 / rate) };
+}
+
+fn writeFlac(_: ?*const c.FLAC__StreamEncoder, buffer: [*c]const u8, bytes: usize, _: u32, _: u32, client: ?*anyopaque) callconv(.c) c.FLAC__StreamEncoderWriteStatus {
+    const out: *std.Io.Writer.Allocating = @ptrCast(@alignCast(client));
+    out.writer.writeAll(buffer[0..bytes]) catch return c.FLAC__STREAM_ENCODER_WRITE_STATUS_FATAL_ERROR;
+    return c.FLAC__STREAM_ENCODER_WRITE_STATUS_OK;
+}
+
+/// With no seek callback libFLAC can't rewrite STREAMINFO at the end, so the MD5 it knows
+/// only then goes into the bytes already written: after `fLaC`, the block header and the
+/// first 18 bytes of STREAMINFO.
+fn setMd5(_: ?*const c.FLAC__StreamEncoder, metadata: [*c]const c.FLAC__StreamMetadata, client: ?*anyopaque) callconv(.c) void {
+    const out: *std.Io.Writer.Allocating = @ptrCast(@alignCast(client));
+    out.written()[26..42].* = metadata.*.data.stream_info.md5sum;
+}
