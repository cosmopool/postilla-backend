+#!/usr/bin/env python3
+"""Writes src/words_table.zig, the letter table of tilla.md (Words).
+
+Run by hand when the letter range or a hand entry changes, never at build time:
+    python3 tools/words_table.py > src/words_table.zig
+A letter decomposes (NFKD), drops its marks and lowercases; one with no ASCII
+decomposition takes the base letter its Unicode name gives (`O WITH STROKE` -> o),
+or the hand entry of the first name word that has one.
+"""
+import unicodedata
+
+HAND = {
+    'SHARP': 'ss', 'ETH': 'd', 'THORN': 'th', 'KRA': 'k', 'ENG': 'n', 'SCHWA': 'e',
+    'GAMMA': 'g', 'IOTA': 'i', 'UPSILON': 'u', 'LAMBDA': 'l', 'DELTA': 'd', 'ESH': 's',
+    'EZH': 'z', 'YOGH': 'y', 'WYNN': 'w', 'HWAIR': 'hv', 'TWO': 'z', 'FIVE': 'q',
+    'SIX': 'h', 'GLOTTAL': 'q', 'DENTAL': 'c', 'LATERAL': 'x', 'ALVEOLAR': 'q',
+    'RETROFLEX': 'q',
+}
+
+
+def base(letter):
+    decomposed = unicodedata.normalize('NFKD', letter.lower())
+    ascii_letters = ''.join(c for c in decomposed if 'a' <= c <= 'z')
+    if ascii_letters:
+        return ascii_letters
+    words = unicodedata.name(letter).split()
+    at = max(i for i, w in enumerate(words) if w in ('LETTER', 'LIGATURE'))
+    return next(HAND.get(w, w.lower()) for w in words[at + 1:] if w in HAND or len(w) <= 2)
+
+
+print("//! Generated by tools/words_table.py from Python's unicodedata; do not edit.")
+print('//! The normalization of each letter U+00C0–U+024F, at index code point - 0xC0;')
+print('//! "" for × and ÷, which aren\'t letters.')
+print('pub const table = [_][]const u8{')
+for cp in range(0xC0, 0x250):
+    rep = '' if cp in (0xD7, 0xF7) else base(chr(cp))
+    print(f'    "{rep}", // U+{cp:04X} {chr(cp)}')
+print('};')
