+//! The word rule, the normalization and the lookup keys of tilla.md (Words). Pure, no
+//! allocator: callers size the buffers. Bytes that aren't valid UTF-8 are separators.
+
+const std = @import("std");
+const table = @import("words_table.zig").table;
+
+/// A word's byte range in its sentence, the `.tilla` word.
+pub const Span = struct { start: u16, end: u16 };
+
+const final_apostrophe = [_][]const u8{ "po", "va", "fa", "da", "di", "sta", "to", "mo", "be", "ca", "pie", "vo", "te" };
+const leading_apostrophe = [_][]const u8{ "sto", "sta", "sti", "ste", "na", "ndrangheta" };
+
+/// Splits `text` into its words, in order, into `out`; `out.len >= text.len` is always
+/// enough. A word ending past byte 65 535 is left out.
+pub fn split(text: []const u8, out: []Span) []Span {
+    var n: usize = 0;
+    var start: usize = 0; // the open word is text[start..end]; none when they're equal
+    var end: usize = 0;
+    var lead: usize = 0; // the last apostrophe that may lead the next word, text[lead..lead_end]
+    var lead_end: usize = 0;
+    var prev: u8 = ' ';
+    var i: usize = 0;
+    while (i <= text.len) { // the end of the text reads as a space, closing the last word
+        const at = i;
+        var k = kind(next(text, &i));
+        if (k == '^') k = if (prev == 'a') 'a' else ' ';
+        var j = i;
+        const after = kind(next(text, &j));
+        const word_after = after == 'a' or after == '0';
+        if (k == 'a' or k == '0') {
+            if (start == end) start = at;
+            end = i;
+        } else if (k != ' ' and prev == 'a' and after == 'a') {
+            end = i;
+        } else {
+            const word = text[start..end];
+            if (lead_end == start and listed(&leading_apostrophe, word)) start = lead;
+            if (k == '\'' and !word_after and listed(&final_apostrophe, word)) end = i;
+            if (start != end and end <= std.math.maxInt(u16)) {
+                out[n] = .{ .start = @intCast(start), .end = @intCast(end) };
+                n += 1;
+            }
+            if (k == '\'' and prev != 'a' and prev != '0' and word_after) {
+                lead = at;
+                lead_end = i;
+            }
+            start = end;
+        }
+        prev = k;
+    }
+    return out[0..n];
+}
+
+/// Writes the normalized `text` into `out` and returns it; `out.len >= text.len` is
+/// always enough.
+pub fn normalize(text: []const u8, out: []u8) []u8 {
+    var n: usize = 0;
+    var i: usize = 0;
+    while (i < text.len) {
+        const at = i;
+        const cp = next(text, &i);
+        const replacement: []const u8 = switch (kind(cp)) {
+            'a' => if (cp >= 0xC0) table[cp - 0xC0] else text[at..i],
+            '^' => "",
+            '\'' => "'",
+            '-' => "-",
+            else => text[at..i],
+        };
+        @memcpy(out[n..][0..replacement.len], replacement);
+        n += replacement.len;
+    }
+    for (out[0..n]) |*b| b.* = std.ascii.toLower(b.*);
+    return out[0..n];
+}
+
+/// The keys to look `word` up by, in order, into `keys`: as written, normalized, then the
+/// same two for the part after its last apostrophe between two letters, skipping a key
+/// equal to the one before it. The normalized keys go in `buf`, `2 * word.len` bytes.
+pub fn lookupKeys(word: []const u8, buf: []u8, keys: *[4][]const u8) [][]const u8 {
+    var tail: usize = 0;
+    var prev: u8 = ' ';
+    var i: usize = 0;
+    while (i < word.len) {
+        var k = kind(next(word, &i));
+        if (k == '^') k = if (prev == 'a') 'a' else ' ';
+        var j = i;
+        if (k == '\'' and prev == 'a' and kind(next(word, &j)) == 'a') tail = i;
+        prev = k;
+    }
+    const norm = normalize(word, buf);
+    const all = [4][]const u8{ word, norm, word[tail..], normalize(word[tail..], buf[norm.len..]) };
+    var n: usize = 0;
+    for (all[0..if (tail == 0) 2 else 4]) |key| {
+        if (n > 0 and std.mem.eql(u8, key, keys[n - 1])) continue;
+        keys[n] = key;
+        n += 1;
+    }
+    return keys[0..n];
+}
+
+/// The class of a character: 'a' letter, '0' digit, '\'' apostrophe, '-' hyphen,
+/// '^' combining accent, ' ' anything else.
+fn kind(cp: u21) u8 {
+    return switch (cp) {
+        'A'...'Z', 'a'...'z', 0xC0...0xD6, 0xD8...0xF6, 0xF8...0x24F => 'a',
+        '0'...'9' => '0',
+        '\'', 0x2019, 0x2BC => '\'',
+        '-', 0x2010, 0x2011 => '-',
+        0x300...0x36F => '^',
+        else => ' ',
+    };
+}
+
+/// Decodes the character at `text[i.*]` and moves `i` past it. A byte that isn't valid
+/// UTF-8, and the end of the text, read as a one-byte space.
+fn next(text: []const u8, i: *usize) u21 {
+    const at = i.*;
+    i.* += 1;
+    if (at >= text.len) return ' ';
+    const len = std.unicode.utf8ByteSequenceLength(text[at]) catch return ' ';
+    if (at + len > text.len) return ' ';
+    const cp = std.unicode.utf8Decode(text[at..][0..len]) catch return ' ';
+    i.* = at + len;
+    return cp;
+}
+
+/// Whether `word`, normalized, is in `list`. A word over 64 bytes is in no list.
+fn listed(list: []const []const u8, word: []const u8) bool {
+    var buf: [64]u8 = undefined;
+    if (word.len > buf.len) return false;
+    const norm = normalize(word, &buf);
+    for (list) |w| if (std.mem.eql(u8, norm, w)) return true;
+    return false;
+}
