@@ -0,0 +1,132 @@
+//! The word rule, the normalization and the lookup keys of docs/tilla.md (Words). No
+//! dependencies and no allocator: callers size the buffers.
+
+const std = @import("std");
+const table = @import("words_table.zig").table;
+
+/// A word's byte range in its sentence, the `.tilla` word.
+pub const Span = struct { start: u16, end: u16 };
+
+const final_apostrophe = [_][]const u8{ "po", "va", "fa", "da", "di", "sta", "to", "mo", "be", "ca", "pie", "vo", "te" };
+const leading_apostrophe = [_][]const u8{ "sto", "sta", "sti", "ste", "na", "ndrangheta" };
+
+/// Splits `text` into its words. `out.len >= text.len` is always enough. Bytes that aren't
+/// valid UTF-8 separate words; no span ends past 65 535.
+pub fn split(text: []const u8, out: []Span) []Span {
+    var n: usize = 0;
+    var i: usize = 0;
+    var len: usize = 0;
+    var next_len: usize = 0; // the length of a code point looked at ahead
+    var run_end: usize = text.len + 1; // where the last run of letters and digits ended
+    var lead: usize = text.len; // an apostrophe right before `i` that may lead a word; text.len = none
+    while (i < text.len) {
+        const cp = decode(text, i, &len);
+        if (!isLetter(cp) and !isDigit(cp)) {
+            lead = if (isApostrophe(cp) and i != run_end) i else text.len;
+            i += len;
+            continue;
+        }
+        var start = i;
+        var letter = false;
+        while (i < text.len) : (i += len) {
+            const c = decode(text, i, &len);
+            const joins = letter and (isApostrophe(c) or isHyphen(c)) and isLetter(decode(text, i + len, &next_len));
+            letter = isLetter(c) or letter and isMark(c);
+            if (!letter and !isDigit(c) and !joins) break;
+        }
+        run_end = i;
+        var end = i;
+        if (isApostrophe(decode(text, i, &len))) {
+            const after = decode(text, i + len, &next_len);
+            if (!isLetter(after) and !isDigit(after) and inList(&final_apostrophe, text[start..end])) end = i + len;
+        }
+        if (lead < text.len and inList(&leading_apostrophe, text[start..run_end])) start = lead;
+        if (end > std.math.maxInt(u16)) break;
+        out[n] = .{ .start = @intCast(start), .end = @intCast(end) };
+        n += 1;
+        i = end;
+    }
+    return out[0..n];
+}
+
+/// Writes the normalized `text` into `out`; `out.len >= text.len` is always enough.
+/// Bytes that aren't valid UTF-8 are copied unchanged.
+pub fn normalize(text: []const u8, out: []u8) []u8 {
+    var n: usize = 0;
+    var i: usize = 0;
+    var len: usize = 0;
+    while (i < text.len) : (i += len) {
+        const cp = decode(text, i, &len);
+        const replacement = if (cp >= 0xC0 and isLetter(cp)) table[cp - 0xC0] else if (isMark(cp)) "" else if (isApostrophe(cp)) "'" else if (isHyphen(cp)) "-" else text[i..][0..len];
+        for (replacement) |b| {
+            out[n] = std.ascii.toLower(b);
+            n += 1;
+        }
+    }
+    return out[0..n];
+}
+
+/// The keys to look `word` up by, in order: as written, normalized, then the same two for
+/// the part after the last apostrophe between two letters; a key equal to the one before
+/// it is skipped. `buf.len >= 2 * word.len` is always enough.
+pub fn lookupKeys(word: []const u8, buf: []u8, keys: *[4][]const u8) []const []const u8 {
+    var tail = word;
+    var prev: u21 = 0;
+    var i: usize = 0;
+    var len: usize = 0;
+    while (i < word.len) : (i += len) {
+        const cp = decode(word, i, &len);
+        var next_len: usize = 0;
+        if (isApostrophe(cp) and isLetter(prev) and isLetter(decode(word, i + len, &next_len))) tail = word[i + len ..];
+        if (!isMark(cp)) prev = cp;
+    }
+    const norm = normalize(word, buf);
+    const all = [4][]const u8{ word, norm, tail, normalize(tail, buf[norm.len..]) };
+    var n: usize = 0;
+    for (all[0..if (tail.len < word.len) 4 else 2]) |key| {
+        if (n > 0 and std.mem.eql(u8, keys[n - 1], key)) continue;
+        keys[n] = key;
+        n += 1;
+    }
+    return keys[0..n];
+}
+
+/// The code point at `text[i]` and its length in `len`; a byte that doesn't start valid
+/// UTF-8 is U+FFFD of length 1, and past the end is 0.
+fn decode(text: []const u8, i: usize, len: *usize) u21 {
+    len.* = 1;
+    if (i >= text.len) return 0;
+    const n = std.unicode.utf8ByteSequenceLength(text[i]) catch return 0xFFFD;
+    if (i + n > text.len) return 0xFFFD;
+    const cp = std.unicode.utf8Decode(text[i..][0..n]) catch return 0xFFFD;
+    len.* = n;
+    return cp;
+}
+
+fn inList(list: []const []const u8, word: []const u8) bool {
+    var buf: [32]u8 = undefined;
+    if (word.len > buf.len) return false;
+    const norm = normalize(word, &buf);
+    for (list) |w| if (std.mem.eql(u8, w, norm)) return true;
+    return false;
+}
+
+fn isLetter(cp: u21) bool {
+    return cp < 0x80 and std.ascii.isAlphabetic(@intCast(cp)) or cp >= 0xC0 and cp <= 0x24F and table[cp - 0xC0].len > 0;
+}
+
+fn isDigit(cp: u21) bool {
+    return cp >= '0' and cp <= '9';
+}
+
+fn isMark(cp: u21) bool {
+    return cp >= 0x300 and cp <= 0x36F;
+}
+
+fn isApostrophe(cp: u21) bool {
+    return cp == '\'' or cp == 0x2019 or cp == 0x2BC;
+}
+
+fn isHyphen(cp: u21) bool {
+    return cp == '-' or cp == 0x2010 or cp == 0x2011;
+}
