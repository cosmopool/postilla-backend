+#!/usr/bin/env python3
+"""Writes src/words_table.zig, the normalization of every letter in U+00C0–U+024F
+(docs/tilla.md, Words). Run by hand when the table changes, never at build time:
+
+    python3 tools/words_table.py > src/words_table.zig
+"""
+import unicodedata
+
+# Letters that don't decompose to an ASCII letter, as tilla.md names them.
+HAND = {'æ': 'ae', 'œ': 'oe', 'ß': 'ss', 'ø': 'o', 'đ': 'd', 'ł': 'l', 'ħ': 'h', 'ð': 'd', 'þ': 'th'}
+# The rest take the closest base from their Unicode name.
+NAMES = {'ETH': 'd', 'THORN': 'th', 'KRA': 'k', 'ENG': 'n', 'SCHWA': 'e', 'GAMMA': 'g', 'IOTA': 'i',
+         'DELTA': 'd', 'LAMBDA': 'l', 'ESH': 's', 'UPSILON': 'u', 'EZH': 'z', 'YOGH': 'g', 'WYNN': 'w',
+         'HWAIR': 'hv', 'YR': 'r'}
+
+
+def base(c):
+    s = ''.join(HAND.get(x, x) for x in unicodedata.normalize('NFKD', c.lower()))
+    s = ''.join(x for x in s if 'a' <= x <= 'z')
+    if s:
+        return s
+    words = [w for w in unicodedata.name(c).split(' LETTER ')[-1].split() if w not in ('SMALL', 'CAPITAL')]
+    return next((NAMES[w] for w in words if w in NAMES),
+                next((w.lower() for w in words if len(w) <= 2), words[0][0].lower()))
+
+
+print('//! Generated by tools/words_table.py: do not edit. The normalization of every letter in')
+print('//! U+00C0–U+024F (docs/tilla.md, Words), at code point - 0xC0; "" for × and ÷, which')
+print('//! are not letters.')
+print()
+print('pub const table = [_][]const u8{')
+for cp in range(0xC0, 0x250):
+    c = chr(cp)
+    print(f'    "{"" if cp in (0xD7, 0xF7) else base(c)}", // U+{cp:04X} {c}')
+print('};')
