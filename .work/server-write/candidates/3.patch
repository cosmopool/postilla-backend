+/// STRY rules 1 to 3 but repeats: fills `langs` and `shas` with `(body.len - 22) / 40` translations.
+fn parseStry(body: []const u8, langs: []wire.Lang, shas: [][]const u8) wire.Reader.Error!wire.StoryId {
+    var r: wire.Reader = .{ .buf = body };
+    try r.header("STRY");
+    const id = try r.storyId();
+    const n = try r.int(u8);
+    if (n == 0 or body.len != 22 + 40 * @as(usize, n)) return error.Short;
+    for (langs[0..n], shas[0..n]) |*l, *sha| {
+        l.* = try r.lang();
+        sha.* = try r.bytes(32);
+    }
+    return id;
+}
