index 0000000..87b16ab
--- /dev/null
+++ b/src/tilla.zig
@@ -0,0 +1,155 @@
+//! The `.tilla` writer (tilla.md): one translation of a story in, its `.tilla` bytes, their
+//! `.gz` and the sha256 of the `.tilla` out. `postilla publish` calls it per translation.
+
+const std = @import("std");
+const c = @import("c");
+const words = @import("words");
+const db = @import("db");
+const wire = @import("wire");
+
+/// One translation of a story, with the story-level fields every translation repeats.
+pub const Input = struct {
+    id: wire.StoryId = .{},
+    lang: wire.Lang = .{},
+    original: wire.Lang = .{},
+    title: []const u8 = "",
+    subtitle: []const u8 = "",
+    level: u8 = 0,
+    genre: []const u8 = "",
+    tags: []const []const u8 = &.{},
+    work: []const u8 = "",
+    part: u16 = 0,
+    author: []const u8 = "",
+    adapted: bool = false,
+    license: []const u8 = "",
+    /// Paragraphs of sentences.
+    paragraphs: []const []const []const u8 = &.{},
+    /// All zero, with no times, without narration; else one time pair per sentence.
+    narration: struct {
+        audio_ms: u32 = 0,
+        opus_sha256: [32]u8 = @splat(0),
+        opus_size: u32 = 0,
+        times: []const struct { start_ms: u32 = 0, end_ms: u32 = 0 } = &.{},
+    } = .{},
+};
+
+pub const Built = struct {
+    tilla: []const u8 = "",
+    gz: []const u8 = "",
+    sha256: [32]u8 = @splat(0),
+};
+
+/// Builds the `.tilla` of `in`. An Italian translation's `band_words` come from the
+/// `dict.db` at `dict`; other languages never open it. Input that would break a reader
+/// rule is refused with `error.BadInput`; a `dict.db` that fails is `error.Sqlite`.
+pub fn build(arena: std.mem.Allocator, in: Input, dict: [:0]const u8) !Built {
+    if (in.title.len == 0 or in.subtitle.len == 0 or in.paragraphs.len == 0) return error.BadInput;
+    var size = 6 + 16 + 8 + 8 + wire.strSize(in.title) + wire.strSize(in.subtitle) + 1 +
+        wire.strSize(in.genre) + 2 + wire.strSize(in.work) + 2 + wire.strSize(in.author) + 1 +
+        wire.strSize(in.license) + 2 + 8 + 4 + 32 + 4 + 2;
+    for (in.tags) |tag| size += wire.strSize(tag);
+    // A span reaches byte 65 535 at most, so no sentence may be longer.
+    const spans = try arena.alloc(words.Span, std.math.maxInt(u16));
+    var total: usize = 0;
+    var sentences: usize = 0;
+    for (in.paragraphs) |p| {
+        if (p.len == 0) return error.BadInput;
+        size += 2;
+        for (p) |text| {
+            if (text.len == 0 or text.len > spans.len) return error.BadInput;
+            const n = words.split(text, spans).len;
+            size += wire.strSize(text) + 2 + 4 * n + 8;
+            total += n;
+            sentences += 1;
+        }
+    }
+    if (total > std.math.maxInt(u16)) return error.BadInput;
+
+    // Reader rule 8.
+    const narration = in.narration;
+    if (narration.times.len != 0 and narration.times.len != sentences) return error.BadInput;
+    var untimed = true;
+    var prev_start: u32 = 0;
+    for (narration.times) |t| {
+        if (t.start_ms < prev_start or t.start_ms > t.end_ms or t.end_ms > narration.audio_ms) return error.BadInput;
+        if (t.end_ms != 0) untimed = false;
+        prev_start = t.start_ms;
+    }
+    if (untimed != (narration.audio_ms == 0 and narration.opus_size == 0 and
+        std.mem.allEqual(u8, &narration.opus_sha256, 0))) return error.BadInput;
+
+    // A word's band: the first lookup key that finds a form decides, by `form` before
+    // `form_norm`; the lowest non-zero band of its lemmas, 0 when every one is 0.
+    var band_words: [4]u16 = @splat(0);
+    if (std.mem.eql(u8, in.lang.text(), "it")) {
+        var d = try db.open(dict);
+        defer d.close();
+        const stmt = try d.prepare(
+            \\SELECT ifnull(min(nullif(e.band, 0)), 0), count(*) FROM form f JOIN entry e ON e.id = f.entry_id
+            \\WHERE f.form = ?1 OR (f.form_norm = ?1 AND NOT EXISTS (SELECT 1 FROM form WHERE form = ?1))
+        );
+        defer _ = c.sqlite3_finalize(stmt.handle);
+        const key_buf = try arena.alloc(u8, 2 * spans.len);
+        var keys: [4][]const u8 = undefined;
+        for (in.paragraphs) |p| for (p) |text| for (words.split(text, spans)) |s| {
+            const band = for (words.lookupKeys(text[s.start..s.end], key_buf, &keys)) |key| {
+                _ = c.sqlite3_reset(stmt.handle);
+                _ = c.sqlite3_bind_text(stmt.handle, 1, key.ptr, @intCast(key.len), null);
+                _ = try stmt.step();
+                if (c.sqlite3_column_int(stmt.handle, 1) > 0) break c.sqlite3_column_int(stmt.handle, 0);
+            } else 0;
+            band_words[@intCast(band)] += 1;
+        };
+    }
+
+    var w: wire.Writer = .{ .buf = try arena.alloc(u8, size) };
+    w.bytes("TILLA");
+    w.int(u8, wire.version);
+    w.bytes(&in.id.bytes);
+    w.bytes(&in.lang.bytes);
+    w.bytes(&in.original.bytes);
+    w.str(in.title);
+    w.str(in.subtitle);
+    w.int(u8, in.level);
+    w.str(in.genre);
+    w.int(u16, @intCast(in.tags.len));
+    for (in.tags) |tag| w.str(tag);
+    w.str(in.work);
+    w.int(u16, in.part);
+    w.str(in.author);
+    w.int(u8, @intFromBool(in.adapted));
+    w.str(in.license);
+    w.int(u16, @intCast(total));
+    for (band_words) |b| w.int(u16, b);
+    w.int(u32, narration.audio_ms);
+    w.bytes(&narration.opus_sha256);
+    w.int(u32, narration.opus_size);
+    w.int(u16, @intCast(in.paragraphs.len));
+    var i: usize = 0;
+    for (in.paragraphs) |p| {
+        w.int(u16, @intCast(p.len));
+        for (p) |text| {
+            w.str(text);
+            const ws = words.split(text, spans);
+            w.int(u16, @intCast(ws.len));
+            for (ws) |s| {
+                w.int(u16, s.start);
+                w.int(u16, s.end);
+            }
+            if (narration.times.len == 0) w.int(u64, 0) else {
+                w.int(u32, narration.times[i].start_ms);
+                w.int(u32, narration.times[i].end_ms);
+            }
+            i += 1;
+        }
+    }
+
+    var gz: std.Io.Writer.Allocating = try .initCapacity(arena, size);
+    var window: [std.compress.flate.max_window_len]u8 = undefined;
+    var z: std.compress.flate.Compress = try .init(&gz.writer, &window, .gzip, .default);
+    try z.writer.writeAll(w.written());
+    try z.finish();
+    var built: Built = .{ .tilla = w.written(), .gz = gz.written() };
+    std.crypto.hash.sha2.Sha256.hash(built.tilla, &built.sha256, .{});
+    return built;
+}
