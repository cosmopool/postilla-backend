index 0000000..4980686
--- /dev/null
+++ b/src/tilla.zig
@@ -0,0 +1,161 @@
+//! The `.tilla` writer (tilla.md): one translation of a story in, its `.tilla` bytes,
+//! their gzip and the sha256 of the `.tilla` out. `postilla publish` calls it once per
+//! translation.
+
+const std = @import("std");
+const c = @import("c");
+const words = @import("words");
+const db = @import("db");
+const wire = @import("wire");
+
+/// One translation and the story-level fields every translation repeats.
+pub const Input = struct {
+    id: wire.StoryId = .{},
+    lang: wire.Lang = .{},
+    original: wire.Lang = .{},
+    title: []const u8 = "",
+    subtitle: []const u8 = "",
+    level: u8 = 0,
+    genre: []const u8 = "",
+    tags: []const []const u8 = &.{},
+    work: []const u8 = "",
+    part: u16 = 0,
+    author: []const u8 = "",
+    adapted: bool = false,
+    license: []const u8 = "",
+    /// Paragraphs of sentences, in reading order.
+    paragraphs: []const []const []const u8 = &.{},
+    /// All zero without narration; otherwise one time pair per sentence, in order.
+    narration: struct {
+        audio_ms: u32 = 0,
+        opus_sha256: [32]u8 = @splat(0),
+        opus_size: u32 = 0,
+        times: []const struct { start_ms: u32 = 0, end_ms: u32 = 0 } = &.{},
+    } = .{},
+};
+
+pub const Built = struct {
+    tilla: []const u8 = "",
+    gz: []const u8 = "",
+    /// Of `tilla`, before gzip.
+    sha256: [32]u8 = @splat(0),
+};
+
+/// Builds `in`'s `.tilla` into `arena`. An Italian translation's `band_words` come from
+/// the `dict.db` at `dict_path`; no other language opens it. Input that would break a
+/// reader rule is refused before anything is written.
+pub fn build(arena: std.mem.Allocator, in: Input, dict_path: [:0]const u8) !Built {
+    const max = std.math.maxInt(u16);
+    const n = in.narration;
+    const silent = n.audio_ms == 0 and n.opus_size == 0 and std.mem.allEqual(u8, &n.opus_sha256, 0);
+    // Reader rule 7 asks band_words of every `it` file.
+    const italian = std.mem.eql(u8, in.lang.text(), "it");
+    if (in.title.len == 0 or in.subtitle.len == 0 or in.paragraphs.len == 0) return error.Empty;
+
+    var dict: db.Db = .{};
+    defer dict.close();
+    var lookup: db.Stmt = .{ .db = dict };
+    defer _ = c.sqlite3_finalize(lookup.handle);
+    if (italian) {
+        dict = try db.open(dict_path);
+        // A key matches `form`, or `form_norm` when no `form` does; no row, no lemma.
+        lookup = try dict.prepare(
+            \\SELECT coalesce(min(nullif(entry.band, 0)), 0) FROM form JOIN entry ON entry.id = form.entry_id
+            \\WHERE form.form = ?1 OR (form.form_norm = ?1 AND NOT EXISTS (SELECT 1 FROM form WHERE form = ?1))
+            \\HAVING count(*) > 0
+        );
+    }
+    const spans = try arena.alloc(words.Span, max);
+    const key_buf = try arena.alloc(u8, 2 * max);
+
+    // The fixed header fields take 96 bytes.
+    var size: usize = 96 + wire.strSize(in.title) + wire.strSize(in.subtitle) + wire.strSize(in.genre) +
+        wire.strSize(in.work) + wire.strSize(in.author) + wire.strSize(in.license);
+    for (in.tags) |tag| size += wire.strSize(tag);
+    var total: usize = 0;
+    var bands: [4]u16 = @splat(0);
+    var sentences: usize = 0;
+    for (in.paragraphs) |p| {
+        if (p.len == 0) return error.Empty;
+        size += 2;
+        for (p) |text| {
+            if (text.len == 0) return error.Empty;
+            if (text.len > max) return error.SentenceTooLong;
+            const ws = words.split(text, spans);
+            total += ws.len;
+            if (total > max) return error.TooManyWords;
+            size += wire.strSize(text) + 2 + 4 * ws.len + 8;
+            sentences += 1;
+            if (italian) for (ws) |w| {
+                var keys: [4][]const u8 = undefined;
+                const band = for (words.lookupKeys(text[w.start..w.end], key_buf, &keys)) |key| {
+                    _ = c.sqlite3_reset(lookup.handle);
+                    _ = c.sqlite3_bind_text(lookup.handle, 1, key.ptr, @intCast(key.len), null);
+                    if (try lookup.step()) break c.sqlite3_column_int(lookup.handle, 0);
+                } else 0;
+                bands[@intCast(band)] += 1;
+            };
+        }
+    }
+
+    // Reader rule 8.
+    if (n.times.len != if (silent) 0 else sentences) return error.BadNarration;
+    var prev_start: u32 = 0;
+    var untimed = true;
+    for (n.times) |t| {
+        if (t.start_ms < prev_start or t.start_ms > t.end_ms or t.end_ms > n.audio_ms) return error.BadNarration;
+        untimed = untimed and t.end_ms == 0;
+        prev_start = t.start_ms;
+    }
+    if (untimed != silent) return error.BadNarration;
+
+    var w: wire.Writer = .{ .buf = try arena.alloc(u8, size) };
+    w.bytes("TILLA");
+    w.int(u8, wire.version);
+    w.bytes(&in.id.bytes);
+    w.bytes(&in.lang.bytes);
+    w.bytes(&in.original.bytes);
+    w.str(in.title);
+    w.str(in.subtitle);
+    w.int(u8, in.level);
+    w.str(in.genre);
+    w.int(u16, @intCast(in.tags.len));
+    for (in.tags) |tag| w.str(tag);
+    w.str(in.work);
+    w.int(u16, in.part);
+    w.str(in.author);
+    w.int(u8, @intFromBool(in.adapted));
+    w.str(in.license);
+    w.int(u16, @intCast(total));
+    for (bands) |b| w.int(u16, b);
+    w.int(u32, n.audio_ms);
+    w.bytes(&n.opus_sha256);
+    w.int(u32, n.opus_size);
+    w.int(u16, @intCast(in.paragraphs.len));
+    var i: usize = 0;
+    for (in.paragraphs) |p| {
+        w.int(u16, @intCast(p.len));
+        for (p) |text| {
+            w.str(text);
+            const ws = words.split(text, spans);
+            w.int(u16, @intCast(ws.len));
+            for (ws) |s| {
+                w.int(u16, s.start);
+                w.int(u16, s.end);
+            }
+            w.int(u32, if (silent) 0 else n.times[i].start_ms);
+            w.int(u32, if (silent) 0 else n.times[i].end_ms);
+            i += 1;
+        }
+    }
+
+    var out: Built = .{ .tilla = w.written() };
+    std.crypto.hash.sha2.Sha256.hash(out.tilla, &out.sha256, .{});
+    var gz: std.Io.Writer.Allocating = try .initCapacity(arena, size);
+    const z = try arena.create(std.compress.flate.Compress);
+    z.* = try .init(&gz.writer, try arena.alloc(u8, std.compress.flate.max_window_len), .gzip, .default);
+    try z.writer.writeAll(out.tilla);
+    try z.finish();
+    out.gz = gz.written();
+    return out;
+}
