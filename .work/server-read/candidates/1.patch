+/// A prepared statement, finalized by its owner on every path. Parameters count from 1
+/// and columns from 0, as in SQLite.
+pub const Stmt = struct {
+    handle: ?*c.sqlite3_stmt = null,
+
+    pub fn finalize(s: Stmt) void {
+        _ = c.sqlite3_finalize(s.handle);
+    }
+
+    pub fn bindInt(s: Stmt, i: usize, v: i64) error{Sqlite}!void {
+        if (c.sqlite3_bind_int64(s.handle, @intCast(i), v) != c.SQLITE_OK) return s.failed();
+    }
+
+    /// `v` must outlive the statement's execution: SQLite doesn't copy it.
+    pub fn bindText(s: Stmt, i: usize, v: []const u8) error{Sqlite}!void {
+        if (c.sqlite3_bind_text(s.handle, @intCast(i), v.ptr, @intCast(v.len), null) != c.SQLITE_OK) return s.failed();
+    }
+
+    /// True when a row is ready, false when the statement is done.
+    pub fn step(s: Stmt) error{Sqlite}!bool {
+        return switch (c.sqlite3_step(s.handle)) {
+            c.SQLITE_ROW => true,
+            c.SQLITE_DONE => false,
+            else => s.failed(),
+        };
+    }
+
+    pub fn columnInt(s: Stmt, i: usize) i64 {
+        return c.sqlite3_column_int64(s.handle, @intCast(i));
+    }
+
+    /// The bytes of a TEXT or BLOB column, valid until the next `step`.
+    pub fn columnBlob(s: Stmt, i: usize) []const u8 {
+        const p: [*]const u8 = @ptrCast(c.sqlite3_column_blob(s.handle, @intCast(i)) orelse return "");
+        return p[0..@intCast(c.sqlite3_column_bytes(s.handle, @intCast(i)))];
+    }
+
+    fn failed(s: Stmt) error{Sqlite} {
+        return fail(.{ .handle = c.sqlite3_db_handle(s.handle) });
+    }
 };
 
