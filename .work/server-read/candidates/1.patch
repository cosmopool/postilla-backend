+/// `GET /stories?since=&lang=`: parses the query, then writes the FEED body. A bad query
+/// sets `status` to 400 and returns the reason.
+fn stories(d: db.Db, arena: std.mem.Allocator, query: []const u8, status: *std.http.Status) ![]const u8 {
+    status.* = .bad_request;
+    var since: ?[]const u8 = null;
+    var lang: ?[]const u8 = null;
+    var params = std.mem.tokenizeScalar(u8, query, '&');
+    while (params.next()) |param| {
+        const name, const value = std.mem.cutScalar(u8, param, '=') orelse .{ param, "" };
+        if (std.mem.eql(u8, name, "since")) {
+            if (since != null) return "since: repeated\n";
+            since = value;
+        } else if (std.mem.eql(u8, name, "lang")) {
+            if (lang != null) return "lang: repeated\n";
+            lang = value;
+        }
+    }
+    const since_text = since orelse "0";
+    if (since_text.len > 10 or std.mem.findNone(u8, since_text, "0123456789") != null) return "since: not a u32\n";
+    const after = std.fmt.parseInt(u32, since_text, 10) catch return "since: not a u32\n";
+
+    var ids: [4]wire.Lang = undefined;
+    var n: usize = 0;
+    var items = std.mem.splitScalar(u8, lang orelse return "lang: missing\n", ',');
+    while (items.next()) |id| : (n += 1) {
+        if (id.len == 0) return "lang: empty id\n";
+        if (n == ids.len) return "lang: more than 4 ids\n";
+        ids[n] = wire.Lang.fromText(id) catch return std.fmt.allocPrint(arena, "lang: unknown id '{s}'\n", .{id});
+        for (ids[0..n]) |*seen| if (std.mem.eql(u8, seen.text(), id)) return std.fmt.allocPrint(arena, "lang: duplicate id '{s}'\n", .{id});
+    }
+    for (ids[0..n]) |*id| {
+        const s = try d.prepare("SELECT 1 FROM language WHERE id = ?1");
+        defer s.finalize();
+        try s.bindText(1, id.text());
+        if (!try s.step()) return std.fmt.allocPrint(arena, "lang: unknown id '{s}'\n", .{id.text()});
+    }
+
+    // Unbound `lang` parameters stay NULL and match no row.
+    const s = try d.prepare(
+        \\SELECT id, lang, change, sha256, cursor, count(*) OVER () FROM story
+        \\WHERE cursor > ?5 AND lang IN (?1, ?2, ?3, ?4) ORDER BY cursor
+    );
+    defer s.finalize();
+    for (ids[0..n], 1..) |*id, i| try s.bindText(i, id.text());
+    try s.bindInt(5, after);
+    var more = try s.step();
+    const count: u32 = if (more) @intCast(s.columnInt(5)) else 0;
+    var w: wire.Writer = .{ .buf = try arena.alloc(u8, 9 + 61 * @as(usize, count)) };
+    w.header("FEED");
+    w.int(u32, count);
+    while (more) : (more = try s.step()) {
+        const change = s.columnInt(2);
+        w.bytes(s.columnBlob(0));
+        // The row's lang is one of `ids`, so it parses.
+        w.bytes(&(wire.Lang.fromText(s.columnBlob(1)) catch unreachable).bytes);
+        w.int(u8, @intCast(change));
+        w.bytes(if (change == 2) &@as([32]u8, @splat(0)) else s.columnBlob(3));
+        w.int(u32, @intCast(s.columnInt(4)));
+    }
+    status.* = .ok;
+    return w.written();
+}
