+/// Answers one request (specification.md, Endpoints): returns the body and sets `status`
+/// when it isn't 200. Only GET is served; any other method or path is a 404.
+fn route(d: db.Db, arena: std.mem.Allocator, head: std.http.Server.Request.Head, status: *std.http.Status) ![]const u8 {
+    const path_end = std.mem.findScalar(u8, head.target, '?') orelse head.target.len;
+    const path = if (head.method == .GET) head.target[0..path_end] else "";
+    if (std.mem.eql(u8, path, "/stories")) return stories(d, arena, head.target[@min(path_end + 1, head.target.len)..], status);
+    if (std.mem.eql(u8, path, "/genres")) return list(d, arena, "GNRS", "SELECT id, it, pt_br, en FROM genre ORDER BY id", 4, 0);
+    if (std.mem.eql(u8, path, "/tags")) return list(d, arena, "TAGS", "SELECT id, it, pt_br, en FROM tag ORDER BY id", 4, 0);
+    if (std.mem.eql(u8, path, "/authors")) return list(d, arena, "AUTH", "SELECT id, name FROM author ORDER BY id", 2, 0);
+    if (std.mem.eql(u8, path, "/languages")) return list(d, arena, "LANG", "SELECT id, name, target, translate FROM language ORDER BY id", 2, 2);
