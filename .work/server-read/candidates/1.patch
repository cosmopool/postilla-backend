+fn list(d: db.Db, arena: std.mem.Allocator, magic: *const [4]u8, sql: [:0]const u8, strs: usize, ints: usize) ![]const u8 {
+    // One read transaction, so the rows the first pass sizes are the rows the second writes.
+    try d.exec("BEGIN");
+    defer d.exec("COMMIT") catch {};
+    var size: usize = 7;
+    var count: u16 = 0;
+    {
+        const s = try d.prepare(sql);
+        defer s.finalize();
+        while (try s.step()) : (count += 1) {
+            size += ints;
+            for (0..strs) |i| size += wire.strSize(s.columnBlob(i));
+        }
+    }
+    var w: wire.Writer = .{ .buf = try arena.alloc(u8, size) };
+    w.header(magic);
+    w.int(u16, count);
+    const s = try d.prepare(sql);
+    defer s.finalize();
+    while (try s.step()) {
+        for (0..strs) |i| w.str(s.columnBlob(i));
+        for (strs..strs + ints) |i| w.int(u8, @intCast(s.columnInt(i)));
+    }
+    return w.written();
