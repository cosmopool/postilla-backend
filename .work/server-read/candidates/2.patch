+        _ = c.sqlite3_bind_text(known, 1, id.ptr, @intCast(id.len), null);
+        if (!try step(d, known))
+            return reason(request, .bad_request, std.fmt.bufPrint(&message, "lang: unknown id '{s}'\n", .{id}) catch unreachable);
+        ids[n] = id;
+    }
