+/// `GET /stories?since=&lang=`: a bad `since` or `lang` gets 400 with the rule it breaks.
+fn stories(d: db.Db, request: *Request, query: []const u8) !void {
+    var since: ?[]const u8 = null;
+    var lang: ?[]const u8 = null;
+    var params = std.mem.splitScalar(u8, query, '&');
+    while (params.next()) |param| {
+        if (std.mem.startsWith(u8, param, "since=")) {
+            if (since != null) return reply(request, .bad_request, "text/plain", "since: repeated\n");
+            since = param["since=".len..];
+        } else if (std.mem.startsWith(u8, param, "lang=")) {
+            if (lang != null) return reply(request, .bad_request, "text/plain", "lang: repeated\n");
+            lang = param["lang=".len..];
+        }
+    }
+    const digits = since orelse "0";
+    if (digits.len > 10 or std.mem.findNone(u8, digits, "0123456789") != null) return reply(request, .bad_request, "text/plain", "since: not a u32\n");
+    const cursor = std.fmt.parseInt(u32, digits, 10) catch return reply(request, .bad_request, "text/plain", "since: not a u32\n");
+
+    var ids: [4][]const u8 = undefined;
+    var n: usize = 0;
+    var reason: [8192 + 64]u8 = undefined; // an id is at most the 8 KiB head
+    var items = std.mem.splitScalar(u8, lang orelse return reply(request, .bad_request, "text/plain", "lang: missing\n"), ',');
+    while (items.next()) |id| : (n += 1) {
+        if (id.len == 0) return reply(request, .bad_request, "text/plain", "lang: empty id\n");
+        if (n == ids.len) return reply(request, .bad_request, "text/plain", "lang: more than 4 ids\n");
+        for (ids[0..n]) |seen| if (std.mem.eql(u8, seen, id)) return reply(request, .bad_request, "text/plain", try std.fmt.bufPrint(&reason, "lang: duplicate id '{s}'\n", .{id}));
+        ids[n] = id;
+    }
+
+    const unknown = try prepare(d, "SELECT column1 FROM (VALUES (?1), (?2), (?3), (?4)) WHERE column1 NOT IN (SELECT id FROM language)");
+    defer _ = c.sqlite3_finalize(unknown);
+    const s = try prepare(d,
+        \\SELECT id, unhex(substr(hex(lang) || '0000000000000000', 1, 16)), change,
+        \\  iif(change = 2, zeroblob(32), sha256), cursor, 9 + 61 * count(*) OVER ()
+        \\FROM story WHERE cursor > ?1 AND lang IN (?2, ?3, ?4, ?5) ORDER BY cursor
+    );
+    defer _ = c.sqlite3_finalize(s);
+    // Binding can only fail on a parameter index out of range: these are fixed.
+    _ = c.sqlite3_bind_int64(s, 1, cursor);
+    for (ids[0..n], 1..) |id, i| {
