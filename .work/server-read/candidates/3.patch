+
+/// True when a row is ready, false when the statement is done.
+fn step(s: Stmt) error{Sqlite}!bool {
+    return switch (c.sqlite3_step(s)) {
+        c.SQLITE_ROW => true,
+        c.SQLITE_DONE => false,
+        else => db.fail(.{ .handle = c.sqlite3_db_handle(s) }),
+    };
+}
+
+/// The bytes of a BLOB or TEXT column, valid until the next `step`.
+fn column(s: Stmt, i: usize) []const u8 {
+    const p: [*]const u8 = @ptrCast(c.sqlite3_column_blob(s, @intCast(i)) orelse return "");
+    return p[0..@intCast(c.sqlite3_column_bytes(s, @intCast(i)))];
+}
