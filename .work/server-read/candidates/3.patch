+/// Answers 200 with `magic`, the row count as a `Count`, then each row's columns as
+/// `layout` says: `s` a `str`, `b` a `u8`, `i` a `u32`, `x` the bytes as they are. The
+/// query's next column is the whole body's size, the same on every row.
+fn rows(request: *Request, s: Stmt, magic: *const [4]u8, comptime Count: type, layout: []const u8) !void {
+    var more = try step(s);
+    const buf = try std.heap.c_allocator.alloc(u8, if (more) @intCast(c.sqlite3_column_int64(s, @intCast(layout.len))) else 5 + @sizeOf(Count));
+    defer std.heap.c_allocator.free(buf);
+    var w: Io.Writer = .fixed(buf);
+    try w.writeAll(magic);
+    try w.writeInt(u8, 1, .big);
+    try w.writeInt(Count, 0, .big);
+    var count: Count = 0;
+    while (more) : (more = try step(s)) {
+        count += 1;
+        for (layout, 0..) |kind, i| switch (kind) {
+            's' => {
+                try w.writeInt(u32, @intCast(column(s, i).len), .big);
+                try w.writeAll(column(s, i));
+            },
+            'b' => try w.writeInt(u8, @intCast(c.sqlite3_column_int64(s, @intCast(i))), .big),
+            'i' => try w.writeInt(u32, @intCast(c.sqlite3_column_int64(s, @intCast(i))), .big),
+            else => try w.writeAll(column(s, i)),
+        };
     }
+    std.mem.writeInt(Count, buf[5..][0..@sizeOf(Count)], count, .big);
+    try reply(request, .ok, "application/octet-stream", w.buffered());
