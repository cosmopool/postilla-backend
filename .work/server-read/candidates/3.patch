+fn prepare(d: db.Db, sql: [:0]const u8) error{Sqlite}!Stmt {
+    var s: ?Stmt = null;
+    if (c.sqlite3_prepare_v2(d.handle, sql.ptr, @intCast(sql.len + 1), &s, null) != c.SQLITE_OK) return db.fail(d);
+    return s.?;
