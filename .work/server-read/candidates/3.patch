+        else if (std.mem.eql(u8, path, "/tags")) .{ "TAGS", "ssss", named ++ "tag ORDER BY id" } //
+        else if (std.mem.eql(u8, path, "/authors")) .{ "AUTH", "ss", "SELECT id, name, 7 + sum(8 + octet_length(id) + octet_length(name)) OVER () FROM author ORDER BY id" } //
