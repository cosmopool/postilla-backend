+            const file = dir.readFileAlloc(io, try std.fmt.allocPrint(a, "{s}.{s}", .{ lang, ext }), a, .unlimited) catch return error.RunNarrate;
+            var sha: [32]u8 = undefined;
+            Sha256.hash(file, &sha, .{});
+            if (ext[0] == 'o') inputs[i].narration = .{ .audio_ms = t.audio.audio_ms, .opus_sha256 = sha, .opus_size = @intCast(file.len), .times = times.items };
+            try uploads.append(a, .{ try std.fmt.allocPrint(a, "stories/{s}/{s}/{s}.{s}", .{ &id.text(), lang, &std.fmt.bytesToHex(sha, .lower), ext }), file });
+        }
+    }
+    for (inputs, map.keys()) |in, lang| if (in.lang.text().len == 0) {
+        where.* = try std.fmt.allocPrint(a, "language '{s}' not listed", .{lang});
+        return error.NotListed;
+    };
+
+    // Build every .tilla, upload them and then the audio, and publish.
+    const c: r2.Client = .{
+        .endpoint = env.get("POSTILLA_R2_ENDPOINT") orelse try std.fmt.allocPrint(a, "https://{s}.r2.cloudflarestorage.com", .{env.get("POSTILLA_R2_ACCOUNT_ID").?}),
+        .bucket = env.get("POSTILLA_R2_BUCKET").?,
+        .access_key_id = env.get("POSTILLA_R2_ACCESS_KEY_ID").?,
+        .secret_access_key = env.get("POSTILLA_R2_SECRET_ACCESS_KEY").?,
+    };
+    const dict_dir = env.get("POSTILLA_DICT_DIR") orelse "./dict";
+    where.* = dict_dir;
+    try cwd.createDirPath(io, dict_dir);
+    const dict = try a.dupeSentinel(u8, try c.dict(io, a, dict_dir), 0);
+    var body: wire.Writer = .{ .buf = try a.alloc(u8, 22 + 40 * inputs.len) };
+    body.header("STRY");
+    body.bytes(&id.bytes);
+    body.int(u8, @intCast(inputs.len));
+    for (inputs) |in| {
+        where.* = try std.fmt.allocPrint(a, "{s} with {s}", .{ in.lang.text(), dict });
+        const built = try tilla.build(a, in, dict);
+        try uploads.insert(a, 0, .{ try std.fmt.allocPrint(a, "stories/{s}/{s}/{s}.tilla.gz", .{ &id.text(), in.lang.text(), &std.fmt.bytesToHex(built.sha256, .lower) }), built.gz });
+        body.bytes(&in.lang.bytes);
+        body.bytes(&built.sha256);
+    }
+    for (uploads.items) |u| {
+        where.* = u[0];
+        if ((try c.put(io, a, u[0], u[1])).status != .ok) return error.R2Status;
+        try Io.File.stdout().writeStreamingAll(io, try std.fmt.allocPrint(a, "uploaded {s}\n", .{u[0]}));
+    }
+    where.* = "POST /stories";
+    const auth = try std.fmt.allocPrint(a, "Bearer {s}", .{env.get("POSTILLA_AUTHOR_TOKEN").?});
+    const res = try outbound.request(io, a, .{}, .POST, try std.fmt.allocPrint(a, "{s}/stories", .{server}), &.{.{ .name = "authorization", .value = auth }}, body.written(), "");
+    if (res.status != .ok) {
+        where.* = try std.fmt.allocPrint(a, "POST /stories: {s}", .{std.mem.trimEnd(u8, res.body, "\n")});
+        return error.Refused;
+    }
+    try Io.File.stdout().writeStreamingAll(io, try std.fmt.allocPrint(a, "published {s}\n", .{&id.text()}));
+}
+
+/// `GET <server><path>`, a 200 whose body starts with `magic`, read past its header.
+fn list(io: Io, a: Allocator, server: []const u8, path: []const u8, magic: *const [4]u8) !wire.Reader {
+    const res = try outbound.request(io, a, .{}, .GET, try std.fmt.allocPrint(a, "{s}{s}", .{ server, path }), &.{}, "", "");
+    if (res.status != .ok) return error.ServerStatus;
+    var r: wire.Reader = .{ .buf = res.body };
+    try r.header(magic);
+    return r;
 }
