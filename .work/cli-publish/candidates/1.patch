+            var times: std.ArrayList(std.meta.Child(@FieldType(@FieldType(tilla.Input, "narration"), "times"))) = .empty;
+            for (t.audio.times) |p| for (p) |pair| try times.append(arena, .{ .start_ms = pair[0], .end_ms = pair[1] });
+            in.narration = .{ .audio_ms = t.audio.audio_ms, .opus_sha256 = digests[0], .opus_size = @intCast(files[0].len), .times = times.items };
+        }
+        const built = tilla.build(arena, in, dict) catch |err| return fail(io, "{s}: build with {s}: {t}", .{ lang, dict, err });
+        try gz.append(arena, .{ try std.fmt.allocPrint(arena, "{s}/{s}.tilla.gz", .{ dir, &std.fmt.bytesToHex(built.sha256, .lower) }), built.gz });
+        w.bytes(&in.lang.bytes);
+        w.bytes(&built.sha256);
+    }
+
+    for ([_][]const [2][]const u8{ gz.items, audio.items }) |list| for (list) |u| {
+        const res = client.put(io, arena, u[0], u[1]) catch |err| return fail(io, "upload {s}: {t}", .{ u[0], err });
+        if (res.status != .ok) return fail(io, "upload {s}: {d}", .{ u[0], @backingInt(res.status) });
+        say(io, .stdout(), "uploaded {s}\n", .{u[0]});
+    };
+    const auth = try std.fmt.allocPrint(arena, "Bearer {s}", .{vars.get("POSTILLA_AUTHOR_TOKEN").?});
+    const res = outbound.request(io, arena, .{}, .POST, try std.fmt.allocPrint(arena, "{s}/stories", .{server_url}), &.{.{ .name = "authorization", .value = auth }}, story, "") catch |err|
+        return fail(io, "POST /stories: {t}", .{err});
+    if (res.status != .ok) return fail(io, "POST /stories: {d} {s}", .{ @backingInt(res.status), std.mem.trimEnd(u8, res.body, "\n") });
+    say(io, .stdout(), "published {s}\n", .{&id.text()});
+}
+
+/// Prints the line, the one reason the command stops, and returns the error that stops it.
+fn fail(io: Io, comptime fmt: []const u8, args: anytype) error{Failed} {
+    say(io, .stderr(), fmt ++ "\n", args);
+    return error.Failed;
+}
+
+fn say(io: Io, file: Io.File, comptime fmt: []const u8, args: anytype) void {
+    var buf: [1024]u8 = undefined;
+    var out = file.writerStreaming(io, &buf);
+    out.interface.print(fmt, args) catch {};
+    out.interface.flush() catch {};
 }
