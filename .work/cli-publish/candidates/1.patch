+/// Opens the database at `path` read-only and sets no pragmas, so nothing is written to it
+/// or next to it.
+pub fn openReadOnly(path: [:0]const u8) error{Sqlite}!Db {
+    var d: Db = .{};
+    if (c.sqlite3_open_v2(path.ptr, &d.handle, c.SQLITE_OPEN_READONLY | c.SQLITE_OPEN_NOMUTEX, null) != c.SQLITE_OK) {
+        const err = fail(d);
+        d.close();
+        return err;
+    }
+    return d;
+}
