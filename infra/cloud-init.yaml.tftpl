#cloud-config
# First boot of the postilla VPS (docs/specification.md, Deployment): postilla-server under
# systemd with a root-only env file, Caddy in front for TLS, Litestream streaming the WAL to
# the private backup bucket. A rebuilt server restores postilla.db from that bucket first.
# Staging is a second postilla-server on the same box: its own user, port, database, token
# and hostname, and no backup.
package_update: true
package_upgrade: true
# Vultr's billing month is the calendar month in UTC; vnstat's months follow the local time.
timezone: Etc/UTC
packages:
  - caddy
  - sqlite3
  - curl
  - vnstat

write_files:
  # SSH takes keys only, whatever the image allows: sshd keeps the first value it reads, and
  # 00- sorts before any drop-in the image or cloud-init ships.
  - path: /etc/ssh/sshd_config.d/00-postilla.conf
    content: |
      PasswordAuthentication no
      KbdInteractiveAuthentication no

  # The only secret the VPS holds besides Litestream's own key.
  - path: /etc/postilla/env
    owner: root:root
    permissions: "0600"
    content: |
      POSTILLA_PORT=8080
      POSTILLA_BIND=127.0.0.1
      POSTILLA_DB=/var/lib/postilla/postilla.db
      POSTILLA_AUTHOR_TOKEN=${author_token}

  - path: /etc/systemd/system/postilla-server.service
    content: |
      [Unit]
      Description=postilla-server
      Wants=network-online.target
      After=network-online.target
      # Without the binary (copied after the first apply) the unit just doesn't start.
      ConditionPathExists=/usr/local/bin/postilla-server

      [Service]
      User=postilla
      Group=postilla
      EnvironmentFile=/etc/postilla/env
      WorkingDirectory=/var/lib/postilla
      ExecStart=/usr/local/bin/postilla-server
      Restart=on-failure
      RestartSec=2
      # One thread and one file per connection.
      LimitNOFILE=65536
      NoNewPrivileges=true
      ProtectSystem=strict
      ProtectHome=true
      PrivateTmp=true
      ReadWritePaths=/var/lib/postilla

      [Install]
      WantedBy=multi-user.target

  - path: /etc/postilla/staging.env
    owner: root:root
    permissions: "0600"
    content: |
      POSTILLA_PORT=8081
      POSTILLA_BIND=127.0.0.1
      POSTILLA_DB=/var/lib/postilla-staging/postilla.db
      POSTILLA_AUTHOR_TOKEN=${staging_token}

  # Production's unit with staging's user, env, binary and directory.
  - path: /etc/systemd/system/postilla-server-staging.service
    content: |
      [Unit]
      Description=postilla-server (staging)
      Wants=network-online.target
      After=network-online.target
      ConditionPathExists=/usr/local/bin/postilla-server-staging

      [Service]
      User=postilla-staging
      Group=postilla-staging
      EnvironmentFile=/etc/postilla/staging.env
      WorkingDirectory=/var/lib/postilla-staging
      ExecStart=/usr/local/bin/postilla-server-staging
      Restart=on-failure
      RestartSec=2
      LimitNOFILE=65536
      NoNewPrivileges=true
      ProtectSystem=strict
      ProtectHome=true
      PrivateTmp=true
      ReadWritePaths=/var/lib/postilla-staging

      [Install]
      WantedBy=multi-user.target

  # Litestream runs as postilla too, so the WAL and its own files keep one owner.
  - path: /etc/systemd/system/litestream.service.d/user.conf
    content: |
      [Service]
      User=postilla
      Group=postilla

  - path: /etc/litestream.yml
    permissions: "0600"
    content: |
      dbs:
        - path: /var/lib/postilla/postilla.db
          replica:
            type: s3
            bucket: ${backup_bucket}
            path: postilla.db
            endpoint: ${r2_host}
            region: auto
            access-key-id: ${litestream_key_id}
            secret-access-key: ${litestream_secret}

  # TLS by Caddy's own ACME certificate for the API name; the server stays on loopback.
  # Deferred: written after the caddy package, so it replaces the package's default.
  - path: /etc/caddy/Caddyfile
    defer: true
    content: |
      ${api_hostname} {
        reverse_proxy 127.0.0.1:8080
      }

      ${staging_hostname} {
        reverse_proxy 127.0.0.1:8081
      }

  # Vultr bills outbound traffic past the allowance per GB, with no cap. Once this month's
  # outbound bytes reach the limit, the API goes dark until the month turns over. vnstat counts
  # every byte the interface sends, so it never undercounts what Vultr bills.
  - path: /usr/local/sbin/postilla-egress-guard
    permissions: "0755"
    content: |
      #!/bin/sh
      set -eu
      limit=${egress_limit_gb}000000000
      flag=/var/lib/postilla-egress-guard/stopped
      iface=$(ip route show default | awk '{print $5; exit}')
      # Field 10 of the one-line output is this month's tx, in bytes.
      tx=$(vnstat -i "$iface" --oneline b | cut -d';' -f10)
      case $tx in ''|*[!0-9]*) exit 0 ;; esac
      if [ "$tx" -ge "$limit" ]; then
        if systemctl is-active --quiet caddy; then
          systemctl stop caddy
          touch "$flag"
          logger -t postilla-egress-guard "stopped caddy: $tx bytes out this month, limit $limit"
        fi
      elif [ -e "$flag" ]; then
        rm "$flag"
        systemctl start caddy
        logger -t postilla-egress-guard "started caddy: new month, $tx bytes out"
      fi

  # The server side of infra/deploy.sh: installs a new binary from stdin, rolls back on failure.
  - path: /usr/local/sbin/postilla-update
    permissions: "0755"
    content: |
      ${indent(6, postilla_update)}
  - path: /etc/cron.d/postilla-egress-guard
    content: |
      PATH=/usr/sbin:/usr/bin:/sbin:/bin
      * * * * * root /usr/local/sbin/postilla-egress-guard

runcmd:
  - systemctl try-reload-or-restart ssh
  - useradd --system --home-dir /var/lib/postilla --shell /usr/sbin/nologin postilla
  - install -d -o postilla -g postilla -m 0750 /var/lib/postilla
  - useradd --system --home-dir /var/lib/postilla-staging --shell /usr/sbin/nologin postilla-staging
  - install -d -o postilla-staging -g postilla-staging -m 0750 /var/lib/postilla-staging
  - chown postilla:postilla /etc/litestream.yml
  - install -d -m 0700 /var/lib/postilla-egress-guard
  # vnstat saves its counters every 5 minutes by default; every minute keeps the guard close.
  - sed -i 's/^;\?SaveInterval .*/SaveInterval 1/' /etc/vnstat.conf
  - systemctl restart vnstat
  - curl -fsSL -o /tmp/litestream.deb https://github.com/benbjohnson/litestream/releases/download/v${litestream_version}/litestream-${litestream_version}-linux-x86_64.deb
  # --force-confold keeps the /etc/litestream.yml written above.
  - dpkg --force-confold -i /tmp/litestream.deb
  # A new server for an existing deployment starts from the backup; a first one starts empty.
  - runuser -u postilla -- litestream restore -if-db-not-exists -if-replica-exists /var/lib/postilla/postilla.db
%{ if binary_url != "" ~}
  - curl -fsSL -o /usr/local/bin/postilla-server ${binary_url}
  - chmod 0755 /usr/local/bin/postilla-server
%{ endif ~}
  - systemctl daemon-reload
  - systemctl enable --now litestream
  - systemctl enable --now postilla-server
  - systemctl enable --now postilla-server-staging
  # Vultr's Ubuntu image enables ufw with SSH only; the Vultr firewall group already filters.
  - ufw allow 80/tcp
  - ufw allow 443
  - systemctl reload caddy
