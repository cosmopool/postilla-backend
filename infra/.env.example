# Copy to .env (git ignores it) and fill in. The keys OpenTofu reads from the environment;
# everything else goes in terraform.tfvars and backend.hcl. One KEY=value per line, no quotes,
# so bash and fish both load it (README.md, Apply).

# Cloudflare API token for OpenTofu: R2 Edit, Account API Tokens Edit, DNS Edit and Zone Read.
CLOUDFLARE_API_TOKEN=

# Vultr API key (Account → API), with your address under its Access Control.
VULTR_API_KEY=

# The postilla-tfstate bucket's R2 key pair, for the s3 backend.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
