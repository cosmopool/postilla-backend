# postilla-server configuration. Copy to .env (never commit it) and fill in the required
# values. The server reads env once at startup and refuses to start when a required value
# is missing. Plain KEY=value lines, so the same file works as a systemd EnvironmentFile.
# The CLI has its own file, cli.env.example. See "Configuration" in docs/specification.md.

# --- Server -------------------------------------------------------------------

# HTTP port.
POSTILLA_PORT=8080
# Bind address. TLS is the reverse proxy's job (Caddy), so keep it on loopback.
POSTILLA_BIND=127.0.0.1
# SQLite database path.
POSTILLA_DB=./postilla.db

# --- Auth ---------------------------------------------------------------------

# Required. Bearer token for POST /stories and DELETE /stories/{id}. Use a long random
# value, e.g. `openssl rand -hex 32`, and give the same value to the CLI (cli.env).
POSTILLA_AUTHOR_TOKEN=
