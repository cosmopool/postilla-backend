# Postilla backend configuration. Copy to .env (never commit it) and fill in the
# required values. The server reads env once at startup and refuses to start when a
# required value is missing. Plain KEY=value lines, so the same file works as a systemd
# EnvironmentFile. See "Configuration" in docs/specification.md.

# --- Server -------------------------------------------------------------------

# HTTP port.
POSTILLA_PORT=8080
# Bind address. TLS is the reverse proxy's job (Caddy), so keep it on loopback.
POSTILLA_BIND=127.0.0.1
# SQLite database path.
POSTILLA_DB=./postilla.db

# --- Auth ---------------------------------------------------------------------

# Required. Bearer token for POST /stories, /stories/{id}/narrate and every /drafts
# endpoint. Use a long random value, e.g. `openssl rand -hex 32`.
POSTILLA_PUBLISH_TOKEN=

# --- Outside services ---------------------------------------------------------

# Required. OpenCode key, used for Jev (moderation) and DeepSeek (translation).
POSTILLA_OPENCODE_KEY=
# Required. Speechify key, used for simba-3.5 (narration).
POSTILLA_SPEECHIFY_KEY=

# --- R2 -----------------------------------------------------------------------

# Required. Cloudflare account id.
POSTILLA_R2_ACCOUNT_ID=
# Required. R2 S3 API credentials, with write access to the story bucket.
POSTILLA_R2_ACCESS_KEY_ID=
POSTILLA_R2_SECRET_ACCESS_KEY=
# Required. The public story bucket.
POSTILLA_R2_BUCKET=

# --- Drafts -------------------------------------------------------------------

# Minimum P(none) from Jev for a draft to pass moderation, from 0 to 1.
POSTILLA_MODERATION_THRESHOLD=0.9
